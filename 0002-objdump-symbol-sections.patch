+static bool
+symbol_matches_disasm_list (bfd *abfd, asymbol *sym,
+			    const struct symbol_entry *symbol_list)
+{
+  const char *name = bfd_asymbol_name (sym);
+  char *alloc = NULL;
+  bool matches = false;
+
+  if (do_demangle && name[0] != '\0')
+    {
+      alloc = bfd_demangle (abfd, name, demangle_flags);
+      if (alloc != NULL)
+	name = alloc;
+    }
+
+  for (const struct symbol_entry *ent = symbol_list; ent; ent = ent->next)
+    if (streq (name, ent->name))
+      {
+	matches = true;
+	break;
+      }
+
+  free (alloc);
+  return matches;
+}
